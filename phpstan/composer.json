{
   "name": "pocketmine/phpstan-plugin-config",
   "description": "PHPStan configuration for SlapperRotation.",
   "license": "CC-BY-NC-SA-4.0",
   "require": {
      "phpstan/phpstan": "^2.1",
      "pocketmine/pocketmine-mp": "^5.0",
      "phpstan/phpstan-strict-rules": "^2.0",
      "phpstan/extension-installer": "^1.0"
   },
   "autoload": {
      "psr-4": {
         "SlapperRotationV2\\": "../src"
      }
   },
   "config": {
      "allow-plugins": {
         "phpstan/extension-installer": true
      }
   }
}
